# Server (never expose this password through a VITE_ variable)
UPLOAD_PASSWORD=replace-with-a-secret-password
MONGO_URI=mongodb://localhost:27017/wmgallery
PORT=3001
# UPLOADS_DIR=./uploads
# FRONTEND_ORIGINS=https://your-frontend.example

# Optional separate API host; omit for same-origin production hosting.
# VITE_API_URL=http://localhost:3001

# Optional S3-compatible storage. Leave credentials empty for local storage.
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Contabo public URLs use https://endpoint/tenant-id:bucket/key
S3_TENANT_ID=
